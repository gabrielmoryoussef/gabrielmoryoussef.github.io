---
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import Hero from '@/components/Hero.astro';
import PubRow from '@/components/PubRow.astro';
import ThemeGlyph from '@/components/ThemeGlyph.astro';
import Icon from '@/components/Icon.astro';
import portrait from '@/assets/portrait.jpg';
import { site, people, themes, education } from '@/data/site';
import { getPublications, getNews, newsLabel, inlineMarkdown } from '@/lib/content';

const pubs = await getPublications();
const featured = pubs.filter((p) => p.data.featured);
const news = (await getNews()).slice(0, 5);
const now = new Date();
const homeThemes = themes.filter((t) => t.home);
const roman = ['i', 'ii', 'iii', 'iv', 'v'];
---

<Base>
  <Hero />

  <!-- 01 · About -->
  <section class="section" id="about" aria-labelledby="about-title">
    <div class="wrap grid-12">
      <div class="section__rail">
        <span class="section__num">01</span>
        <h2 class="section__title" id="about-title">About</h2>
      </div>
      <div class="section__body about">
        <div class="prose about__bio" data-reveal>
          <p>
            I recently completed my PhD in Statistics &amp; Data Science at Carnegie Mellon University, co-advised by{' '}
            <a href={people.jin.url} rel="noopener">{people.jin.name}</a> and{' '}
            <a href={people.ke.url} rel="noopener">{people.ke.name}</a>. I work in high-dimensional
            statistics, mostly on problems where the signal is rare, weak, or hidden in some latent structure. Lately,
            I’ve also been working on large language models.
          </p>
          <p>
            Before CMU, I studied at ENS Paris-Saclay (MVA), the University of Oxford, where I was interested in Topological Data Analysis, and Imperial College London. In January 2027 I’m joining the{' '}
            <a href={site.next.url} rel="noopener">Voleon Group</a> as a Member of Research Staff.
          </p>
          <p class="about__thesis">
            <span class="eyebrow">Thesis</span>
            <span class="serif">{site.thesis}</span>
          </p>
        </div>
        <figure class="about__photo" data-reveal style="--i:1">
          <div class="about__frame">
            <Image
              src={portrait}
              alt="Gabriel with trekking poles on a granite trail, high above a deep glacial valley, with Half Dome in the distance."
              widths={[360, 480, 640, 800, 960]}
              sizes="(min-width: 1320px) 400px, (min-width: 1100px) 30vw, (min-width: 720px) 60vw, 100vw"
              quality={68}
              loading="lazy"
              decoding="async"
            />
          </div>
          <figcaption class="about__caption">
            <span class="about__fig">Fig. 2</span> On the trail.
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- 02 · Research -->
  <section class="section" id="research" aria-labelledby="research-title">
    <div class="wrap grid-12">
      <div class="section__rail">
        <span class="section__num">02</span>
        <h2 class="section__title" id="research-title">Research</h2>
      </div>
      <div class="section__body">
        <ol class="themes" role="list">
          {
            homeThemes.map((t, i) => {
              const papers = pubs.filter((p) => p.data.themes.includes(t.key));
              return (
                <li class="theme" data-reveal style={`--i:${i}`}>
                  <div class="theme__head">
                    <span class="theme__num">{roman[i]}.</span>
                    <ThemeGlyph theme={t.key} />
                  </div>
                  <h3 class="theme__title">{t.label}</h3>
                  <p class="theme__blurb">{t.blurb}</p>
                  <ul class="theme__papers" role="list">
                    {papers.map((p) => (
                      <li>
                        <a class="link" href={`/publications/#${p.id}`}>
                          {p.data.title.split(':')[0]}
                        </a>
                      </li>
                    ))}
                  </ul>
                  <a class="arrow-link theme__more" href={`/publications/?theme=${t.key}`}>
                    {papers.length} {papers.length === 1 ? 'paper' : 'papers'}
                    <Icon name="arrow" />
                  </a>
                </li>
              );
            })
          }
        </ol>
      </div>
    </div>
  </section>

  <!-- 03 · Selected publications -->
  <section class="section" id="publications" aria-labelledby="pubs-title">
    <div class="wrap grid-12">
      <div class="section__rail">
        <span class="section__num">03</span>
        <h2 class="section__title" id="pubs-title">Selected publications</h2>
      </div>
      <div class="section__body">
        <div class="pubs">
          {featured.map((p, i) => <PubRow pub={p} index={i} />)}
        </div>
        <a class="arrow-link pubs__all" href="/publications/">
          All publications ({pubs.length})
          <Icon name="arrow" />
        </a>
      </div>
    </div>
  </section>

  <!-- 04 · News -->
  <section class="section" id="news" aria-labelledby="news-title">
    <div class="wrap grid-12">
      <div class="section__rail">
        <span class="section__num">04</span>
        <h2 class="section__title" id="news-title">News</h2>
      </div>
      <div class="section__body">
        <ol class="timeline" role="list">
          {
            news.map((n, i) => {
              const upcoming = n.data.date > now;
              return (
                <li class:list={['timeline__item', { 'is-upcoming': upcoming }]} data-reveal style={`--i:${i}`}>
                  <span class="timeline__date">
                    <time datetime={n.data.date.toISOString().slice(0, 10)}>{newsLabel(n)}</time>
                    {upcoming && <span class="badge badge--accent timeline__badge">Upcoming</span>}
                  </span>
                  <p class="timeline__text" set:html={inlineMarkdown(n.data.text)} />
                </li>
              );
            })
          }
        </ol>
      </div>
    </div>
  </section>

  <!-- 05 · Education -->
  <section class="section" id="education" aria-labelledby="edu-title">
    <div class="wrap grid-12">
      <div class="section__rail">
        <span class="section__num">05</span>
        <h2 class="section__title" id="edu-title">Education</h2>
      </div>
      <div class="section__body">
        <ol class="edu" role="list">
          {
            education.map((e, i) => (
              <li class="edu__item" data-reveal style={`--i:${i}`}>
                <span class="edu__years">{e.years}</span>
                <div>
                  <h3 class="edu__degree">{e.degree}</h3>
                  <p class="edu__school">{e.school}</p>
                  {e.note && <p class="edu__note">{e.note}</p>}
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <!-- 06 · Contact -->
  <section class="section contact" id="contact" aria-labelledby="contact-title">
    <div class="wrap grid-12">
      <div class="section__rail">
        <span class="section__num">06</span>
        <h2 class="section__title" id="contact-title">Contact</h2>
      </div>
      <div class="section__body">
        <p class="contact__lede" data-reveal>
          Curious about research at{' '}
          <a class="contact__voleon" href={site.next.url} rel="noopener">Voleon</a>?{' '}
          <span class="contact__soft">I’m always happy to chat.</span>
        </p>
        <a
          class="contact__cta"
          href="#contact"
          data-email
          data-u={site.email.user}
          data-d={site.email.domain}
          data-reveal
          style="--i:1"
        >
          <span class="eyebrow contact__cta-label">Write to me</span>
          <span class="contact__cta-addr" data-email-text
            >{site.email.user} [at] {site.email.domain.replace(/\./g, ' [dot] ')}</span
          >
          <Icon name="arrow-up-right" class="contact__cta-icon" />
        </a>
        <dl class="contact__list" data-reveal style="--i:2">
          <div>
            <dt class="eyebrow">Based in</dt>
            <dd>{site.location}</dd>
          </div>
          <div>
            <dt class="eyebrow">Elsewhere</dt>
            <dd class="contact__elsewhere">
              <a class="link" href={site.links.scholar} rel="noopener me">Google Scholar</a>
              <a class="link" href={site.links.github} rel="noopener me">GitHub</a>
              <a class="link" href={site.links.linkedin} rel="noopener me">LinkedIn</a>
              <a class="link" href={site.links.cv}>CV (PDF)</a>
            </dd>
          </div>
        </dl>
      </div>
    </div>
  </section>
</Base>

<style>
  /* About ------------------------------------------------------------- */
  .about {
    display: grid;
    gap: var(--space-xl);
  }

  .about__photo {
    max-width: 30rem;
  }

  .about__frame {
    overflow: hidden;
    border-radius: var(--radius-s);
    background: var(--paper-raised);
    box-shadow: 0 0 0 1px var(--rule);
    aspect-ratio: 24 / 25;
  }

  .about__frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Zoom toward the subject (lower right third) on hover. */
    transform-origin: 85% 72%;
    filter: saturate(0.9) contrast(1.02);
    transition:
      transform 1.2s var(--ease-out),
      filter var(--dur-slow) var(--ease-out);
  }

  @media (hover: hover) {
    .about__photo:hover :global(img) {
      transform: scale(1.045);
      filter: none;
    }
  }

  .about__caption {
    display: flex;
    gap: 0.6rem;
    margin-top: var(--space-xs);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: var(--tracking-mono);
    color: var(--ink-3);
  }

  .about__fig {
    color: var(--ink);
  }

  .about__bio {
    font-size: var(--step-1);
  }

  .about__thesis {
    display: grid;
    gap: 0.35rem;
    margin-top: var(--space-l) !important;
    padding-top: var(--space-s);
    border-top: 1px solid var(--rule);
    max-width: 44ch;
  }

  .about__thesis .serif {
    font-size: var(--step-2);
    line-height: 1.2;
    font-style: italic;
  }

  @media (min-width: 1100px) {
    .about {
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
      align-items: start;
      gap: var(--col-gap);
    }

    .about__photo {
      max-width: none;
      padding-top: 0.45rem;
    }
  }

  /* Research ------------------------------------------------------------ */
  .themes {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }

  .theme {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding-block: var(--space-l);
    border-bottom: 1px solid var(--rule);
  }

  .theme__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-2xs);
  }

  .theme__num {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--accent);
  }

  .theme__title {
    font-size: var(--step-2);
    line-height: 1.1;
  }

  .theme__blurb {
    color: var(--ink-2);
    font-size: var(--step-0);
    max-width: 46ch;
  }

  .theme__papers {
    margin: var(--space-2xs) 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.35rem;
    font-size: var(--step--1);
  }

  .theme__papers li {
    display: flex;
    gap: 0.6rem;
    color: var(--ink-2);
  }

  .theme__papers li::before {
    content: '—';
    color: var(--ink-3);
  }

  .theme__papers .link {
    color: var(--ink-2);
  }

  .theme__more {
    margin-top: auto;
    padding-top: var(--space-s);
  }

  @media (min-width: 760px) {
    .themes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .theme {
      padding-right: var(--space-l);
    }

    .theme:nth-child(even) {
      padding-left: var(--space-l);
      padding-right: 0;
      border-left: 1px solid var(--rule);
    }
  }

  /* Publications -------------------------------------------------------- */
  .pubs {
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }

  .pubs__all {
    margin-top: var(--space-l);
  }

  /* News ------------------------------------------------------------------ */
  .timeline {
    position: relative;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .timeline__item {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.35rem var(--col-gap);
    padding: var(--space-s) 0 var(--space-s) 1.6rem;
    border-left: 1px solid var(--rule-strong);
  }

  .timeline__item::before {
    content: '';
    position: absolute;
    left: -4px;
    top: calc(var(--space-s) + 0.5em);
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--paper);
    border: 1px solid var(--ink-3);
  }

  .timeline__item.is-upcoming::before {
    background: var(--accent);
    border-color: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-soft);
  }

  .timeline__date {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: var(--tracking-mono);
    color: var(--ink-3);
  }

  .timeline__badge {
    font-size: 0.65rem;
  }

  .timeline__text {
    font-size: var(--step-1);
    line-height: 1.45;
    max-width: 52ch;
  }

  @media (min-width: 760px) {
    .timeline__item {
      grid-template-columns: 10rem minmax(0, 1fr);
      align-items: baseline;
    }

    .timeline__date {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.35rem;
    }
  }

  /* Education ------------------------------------------------------------ */
  .edu {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--rule);
  }

  .edu__item {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.25rem var(--col-gap);
    padding-block: var(--space-m);
    border-bottom: 1px solid var(--rule);
  }

  .edu__years {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
    padding-top: 0.3rem;
  }

  .edu__degree {
    font-size: var(--step-2);
    line-height: 1.15;
  }

  .edu__school {
    color: var(--ink);
    margin-top: 0.15rem;
  }

  .edu__note {
    color: var(--ink-3);
    font-size: var(--step--1);
    margin-top: 0.2rem;
  }

  @media (min-width: 760px) {
    .edu__item {
      grid-template-columns: 10rem minmax(0, 1fr);
    }
  }

  /* Contact --------------------------------------------------------------- */
  .contact__lede {
    font-family: var(--font-display);
    font-size: var(--step-3);
    line-height: 1.12;
    letter-spacing: -0.01em;
    max-width: 19em;
    text-wrap: balance;
  }

  .contact__voleon {
    font-style: italic;
    background-image: linear-gradient(var(--accent), var(--accent));
    background-size: 100% 1px;
    background-position: 0 92%;
    background-repeat: no-repeat;
    transition: color var(--dur-fast);
  }

  .contact__voleon:hover {
    color: var(--accent);
  }

  .contact__soft {
    color: var(--ink-3);
  }

  /* The email as a single quiet call to action: a hairline row that warms on hover. */
  .contact__cta {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.35rem var(--space-m);
    margin-top: var(--space-l);
    padding: var(--space-m) var(--space-s);
    margin-inline: calc(-1 * var(--space-s));
    border-top: 1px solid var(--rule-strong);
    border-bottom: 1px solid var(--rule);
    color: var(--ink);
    transition:
      background-color var(--dur-base) var(--ease-out),
      color var(--dur-fast);
  }

  .contact__cta-label {
    grid-column: 1;
  }

  .contact__cta-addr {
    grid-column: 1;
    font-family: var(--font-mono);
    font-size: var(--step-1);
    letter-spacing: var(--tracking-mono);
    overflow-wrap: anywhere;
  }

  .contact__cta :global(.contact__cta-icon) {
    grid-column: 2;
    grid-row: 1 / span 2;
    width: 1.5rem;
    height: 1.5rem;
    color: var(--ink-3);
    transition:
      transform var(--dur-base) var(--ease-out),
      color var(--dur-fast);
  }

  .contact__cta:hover {
    background: var(--accent-soft);
  }

  .contact__cta:hover .contact__cta-addr,
  .contact__cta:hover :global(.contact__cta-icon) {
    color: var(--accent);
  }

  .contact__cta:hover :global(.contact__cta-icon) {
    transform: translate(3px, -3px);
  }

  .contact__list {
    display: grid;
    gap: var(--space-m);
    margin-top: var(--space-l);
  }

  .contact__list dd {
    margin: 0.35rem 0 0;
    font-size: var(--step-0);
  }

  .contact__elsewhere {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
  }

  @media (min-width: 760px) {
    .contact__list {
      grid-template-columns: 1fr 2fr;
      gap: var(--col-gap);
    }
  }
</style>
