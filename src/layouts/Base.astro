---
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '@/styles/global.css';
import serifWoff2 from '@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url';

import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import CommandPalette from '@/components/CommandPalette.astro';
import { site, education } from '@/data/site';

interface Props {
  title?: string;
  description?: string;
  /** Path of the page, used for canonical URL. */
  path?: string;
  noindex?: boolean;
}

const { title, description = site.description, noindex = false } = Astro.props;
const fullTitle = title ? `${title} — ${site.name}` : `${site.name} — Statistics, rare signals & latent structure`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og.png', Astro.site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  givenName: site.givenName,
  familyName: site.familyName,
  url: site.url,
  image: new URL('/icon-512.png', Astro.site).href,
  description: site.statement,
  affiliation: { '@type': 'CollegeOrUniversity', name: 'Carnegie Mellon University', url: 'https://www.cmu.edu' },
  alumniOf: education.map((e) => ({ '@type': 'CollegeOrUniversity', name: e.school })),
  knowsAbout: [
    'High-dimensional statistics',
    'Higher Criticism',
    'Vertex hunting',
    'Topic models',
    'Bradley–Terry–Luce model',
    'AI-generated text detection',
    'Topological data analysis',
  ],
  sameAs: [site.links.scholar, site.links.github, site.links.linkedin],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <!-- Apply theme before first paint: no flash. -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        try {
          var t = localStorage.getItem('theme');
          if (t === 'light' || t === 'dark') d.setAttribute('data-theme', t);
        } catch (e) {}
      })();
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="author" content={site.name} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f4f0e6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#151412" media="(prefers-color-scheme: dark)" />
    <meta name="google-site-verification" content={site.googleSiteVerification} />

    <link rel="preload" href={serifWoff2} as="font" type="font/woff2" crossorigin />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} — a noisy point cloud resolving into a simplex.`} />
    <meta property="profile:first_name" content={site.givenName} />
    <meta property="profile:last_name" content={site.familyName} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="page-grid" aria-hidden="true">
      <div class="page-grid__inner">
        <div class="page-grid__cols">
          {Array.from({ length: 12 }, () => <span />)}
        </div>
      </div>
    </div>
    <div class="scroll-progress" aria-hidden="true"></div>

    <Nav />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />

    <CommandPalette />
    <div class="toast" id="toast" role="status" aria-live="polite"></div>
    <div class="grain" aria-hidden="true"></div>

    <script>
      import '@/scripts/site';
    </script>
  </body>
</html>

<style is:global>
  main:focus {
    outline: none;
  }

  .scroll-progress {
    position: fixed;
    inset: 0 0 auto 0;
    height: 1px;
    z-index: 60;
    background: var(--accent);
    transform-origin: 0 50%;
    transform: scaleX(var(--progress, 0));
    pointer-events: none;
  }

  @supports (animation-timeline: scroll()) {
    .scroll-progress {
      animation: progress linear both;
      animation-timeline: scroll(root block);
    }

    @keyframes progress {
      from {
        transform: scaleX(0);
      }
      to {
        transform: scaleX(1);
      }
    }
  }

  .toast {
    position: fixed;
    left: 50%;
    bottom: calc(1.25rem + env(safe-area-inset-bottom, 0px));
    z-index: 80;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 0.9rem;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: var(--tracking-mono);
    border-radius: var(--radius-s);
    box-shadow: var(--shadow-pop);
    opacity: 0;
    transform: translate(-50%, 12px);
    pointer-events: none;
    transition:
      opacity var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-spring);
  }

  .toast.is-on {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  .toast:empty {
    padding: 0;
  }
</style>
