---
import Mark from './Mark.astro';
import { site } from '@/data/site';

const built = new Date();
const year = built.getFullYear();
const stamp = built.toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' });
---

<footer class="footer">
  <div class="wrap footer__inner">
    <div class="footer__left">
      <Mark size={16} />
      <span>© {year} {site.name}</span>
    </div>
    <p class="footer__colophon">
      Set in Instrument Serif, Inter &amp; JetBrains Mono. Updated {stamp}.
    </p>
    <a class="footer__top link" href="#main">Back to top ↑</a>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--rule);
    padding-block: var(--space-l) calc(var(--space-l) + env(safe-area-inset-bottom, 0px));
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: var(--tracking-mono);
    color: var(--ink-3);
  }

  .footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xs) var(--space-l);
  }

  .footer__left {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--ink-2);
  }

  .footer__colophon {
    flex: 1 1 18rem;
  }

  .footer__top {
    color: var(--ink-2);
  }

  @media print {
    .footer {
      display: none;
    }
  }
</style>
