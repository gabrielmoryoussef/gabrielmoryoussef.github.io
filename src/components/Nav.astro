---
import Icon from './Icon.astro';
import Mark from './Mark.astro';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
  { href: '/#about', label: 'About' },
  { href: '/#research', label: 'Research' },
  { href: '/publications/', label: 'Publications', match: '/publications' },
  { href: '/#news', label: 'News' },
  { href: '/#contact', label: 'Contact' },
];
---

<div class="nav-sentinel" aria-hidden="true"></div>
<header class="nav" data-nav>
  <nav class="nav__inner wrap" aria-label="Primary">
    <a class="nav__brand" href="/" aria-label="G. Moryoussef — home">
      <Mark size={18} morph />
      <span class="nav__name">G. Moryoussef</span>
    </a>

    <ul class="nav__links" role="list">
      {
        links.map((l) => (
          <li>
            <a href={l.href} class="nav__link" aria-current={l.match && path === l.match ? 'page' : undefined}>
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="nav__tools">
      <a href="/publications/" class="nav__link nav__papers" aria-current={path === '/publications' ? 'page' : undefined}
        >Papers</a
      >
      <button class="nav__btn nav__cmdk" type="button" data-cmdk-open aria-haspopup="dialog" aria-controls="cmdk">
        <Icon name="search" size={15} />
        <span class="nav__kbd" aria-hidden="true"><kbd>⌘</kbd><kbd>K</kbd></span>
        <span class="visually-hidden">Search sections and papers</span>
      </button>
      <button class="nav__btn" type="button" data-theme-toggle aria-label="Color theme: system">
        <Icon name="system" size={16} class="ti ti--system" />
        <Icon name="sun" size={16} class="ti ti--light" />
        <Icon name="moon" size={16} class="ti ti--dark" />
      </button>
    </div>
  </nav>
</header>

<style>
  .nav-sentinel {
    position: absolute;
    top: 0;
    height: 24px;
    width: 1px;
  }

  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    height: calc(var(--nav-h) + 1rem);
    display: flex;
    align-items: center;
    border-bottom: 1px solid transparent;
    transition:
      height var(--dur-base) var(--ease-out),
      background-color var(--dur-base) var(--ease-out),
      border-color var(--dur-base) var(--ease-out);
    view-transition-name: site-nav;
  }

  .nav.is-condensed {
    height: var(--nav-h);
    background: color-mix(in srgb, var(--paper) 86%, transparent);
    border-bottom-color: var(--rule);
    -webkit-backdrop-filter: saturate(1.2) blur(10px);
    backdrop-filter: saturate(1.2) blur(10px);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    gap: var(--space-m);
  }

  .nav__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--ink);
    margin-right: auto;
    padding-block: 0.4rem;
  }

  .nav__brand :global(svg) {
    transition: transform var(--dur-slow) var(--ease-out);
  }

  .nav__brand:hover :global(svg) {
    transform: rotate(120deg);
  }

  .nav__name {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: var(--tracking-mono);
  }

  .nav__links {
    display: none;
    gap: clamp(1rem, 2vw, 2rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav__link {
    position: relative;
    font-size: var(--step--1);
    color: var(--ink-2);
    padding-block: 0.4rem;
    transition: color var(--dur-fast);
  }

  .nav__link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.15rem;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform var(--dur-base) var(--ease-out);
  }

  .nav__link:hover,
  .nav__link[aria-current='page'] {
    color: var(--ink);
  }

  .nav__link:hover::after,
  .nav__link[aria-current='page']::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .nav__tools {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .nav__papers {
    margin-right: 0.4rem;
  }

  .nav__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    height: 2.25rem;
    min-width: 2.25rem;
    justify-content: center;
    padding-inline: 0.55rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius-s);
    background: transparent;
    color: var(--ink-2);
    transition:
      color var(--dur-fast),
      border-color var(--dur-fast),
      background-color var(--dur-fast);
  }

  .nav__btn:hover {
    color: var(--ink);
    border-color: var(--rule-strong);
    background: var(--paper-raised);
  }

  .nav__kbd {
    display: none;
    gap: 2px;
  }

  kbd {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    line-height: 1;
    padding: 0.2em 0.35em;
    border: 1px solid var(--rule);
    border-radius: 3px;
    color: var(--ink-3);
  }

  /* Theme icon shows the *current* mode. */
  .nav__btn :global(.ti) {
    display: none;
  }

  :global(:root:not([data-theme])) .nav__btn :global(.ti--system),
  :global(:root[data-theme='light']) .nav__btn :global(.ti--light),
  :global(:root[data-theme='dark']) .nav__btn :global(.ti--dark) {
    display: block;
  }

  @media (min-width: 860px) {
    .nav__links {
      display: flex;
    }

    .nav__papers {
      display: none;
    }

    .nav__kbd {
      display: inline-flex;
    }

    .nav__tools {
      margin-left: var(--space-s);
    }
  }

  @media print {
    .nav {
      display: none;
    }
  }
</style>
