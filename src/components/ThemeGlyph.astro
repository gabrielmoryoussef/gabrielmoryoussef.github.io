---
/** Small figure-like glyphs for each research theme. Hairline ink + one accent mark. */
import type { ThemeKey } from '@/data/site';
interface Props {
  theme: ThemeKey;
}
const { theme } = Astro.props;
---

<svg class="glyph" viewBox="0 0 64 40" width="64" height="40" aria-hidden="true" focusable="false">
  {
    theme === 'rare-signals' && (
      <g>
        {Array.from({ length: 34 }, (_, i) => {
          const h = (k: number) => {
            const v = Math.sin(i * 127.1 + k * 311.7) * 43758.5453;
            return v - Math.floor(v);
          };
          const x = 4 + h(1) * 56;
          const y = 5 + h(2) * 30;
          return <circle cx={x} cy={y} r="0.9" fill="currentColor" opacity="0.45" />;
        })}
        <circle cx="47" cy="12" r="2.2" fill="var(--accent)" />
        <circle cx="47" cy="12" r="5" fill="none" stroke="var(--accent)" stroke-width="0.6" opacity="0.6" />
      </g>
    )
  }
  {
    theme === 'latent-structure' && (
      <g>
        <path d="M32 4 56 36H8z" fill="none" stroke="currentColor" stroke-width="0.8" stroke-dasharray="2 2.5" opacity="0.7" />
        {[
          [30, 22], [36, 27], [24, 30], [41, 31], [33, 15], [20, 33], [45, 33], [28, 26], [38, 21],
        ].map(([x, y]) => (
          <circle cx={x} cy={y} r="0.9" fill="currentColor" opacity="0.5" />
        ))}
        <circle cx="32" cy="4" r="2.2" fill="var(--accent)" />
        <circle cx="56" cy="36" r="1.8" fill="currentColor" />
        <circle cx="8" cy="36" r="1.8" fill="currentColor" />
      </g>
    )
  }
  {
    theme === 'ranking' && (
      <g>
        {[30, 24, 19, 13, 8].map((w, i) => (
          <g>
            <rect x="14" y={5 + i * 6.5} width={w + 16} height="2.4" rx="1.2" fill={i === 0 ? 'var(--accent)' : 'currentColor'} opacity={i === 0 ? 1 : 0.55} />
            <text x="4" y={7.6 + i * 6.5} font-size="5" font-family="ui-monospace, monospace" fill="currentColor" opacity="0.6">{i + 1}</text>
          </g>
        ))}
      </g>
    )
  }
  {
    theme === 'llm' && (
      <g>
        {[44, 52, 38, 48, 30].map((w, i) => (
          <rect x="4" y={5 + i * 6.5} width={w} height="1.6" rx="0.8" fill="currentColor" opacity="0.45" />
        ))}
        <rect x="22" y="11.5" width="22" height="1.6" rx="0.8" fill="var(--accent)" />
        <rect x="10" y="24.5" width="16" height="1.6" rx="0.8" fill="var(--accent)" />
      </g>
    )
  }
  {
    theme === 'topology' && (
      <g fill="none" stroke="currentColor" stroke-width="0.8" opacity="0.7">
        <path d="M20 30c-10-4-8-20 4-20s18 18 8 22-20-10-8-18 22 2 18 12" />
        <circle cx="44" cy="12" r="2" fill="var(--accent)" stroke="none" opacity="1" />
      </g>
    )
  }
</svg>

<style>
  .glyph {
    color: var(--ink);
    overflow: visible;
  }
</style>
