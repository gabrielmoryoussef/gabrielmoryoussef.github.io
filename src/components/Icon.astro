---
/**
 * Inline SVG icons. Brand marks come from simple-icons at build time (zero runtime cost);
 * the rest are drawn on a 24-unit grid with a 1.5 stroke to match the hairline aesthetic.
 */
import { siGithub, siGooglescholar } from 'simple-icons';

export type IconName =
  | 'cv'
  | 'scholar'
  | 'github'
  | 'linkedin'
  | 'mail'
  | 'arrow'
  | 'arrow-up-right'
  | 'pdf'
  | 'arxiv'
  | 'code'
  | 'quote'
  | 'chevron'
  | 'sun'
  | 'moon'
  | 'system'
  | 'search'
  | 'link'
  | 'check'
  | 'pin';

interface Props {
  name: IconName;
  size?: number | string;
  class?: string;
  label?: string;
}

const { name, size = '1em', class: cls, label } = Astro.props;

const filled: Partial<Record<IconName, string>> = {
  github: siGithub.path,
  scholar: siGooglescholar.path,
};

const stroked: Partial<Record<IconName, string>> = {
  cv: '<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/><path d="M9 13h6M9 17h4"/>',
  linkedin:
    '<rect x="3" y="3" width="18" height="18" rx="2.5"/><path d="M8 10.5V17M8 7.25v.01M12 17v-3.6c0-1.6.9-2.9 2.4-2.9s2.1 1.1 2.1 2.6V17M12 10.5V17"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3.5 6.5 8.5 6.5 8.5-6.5"/>',
  arrow: '<path d="M4 12h15M13 6l6 6-6 6"/>',
  'arrow-up-right': '<path d="M7 17 17 7M8 7h9v9"/>',
  pdf: '<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/><path d="M12 11v6M9.5 14.5 12 17l2.5-2.5"/>',
  arxiv: '<path d="M5 4l14 16M19 4 12.5 11.5M5 20l4-4.5"/>',
  code: '<path d="m8 7-5 5 5 5M16 7l5 5-5 5M13.5 4l-3 16"/>',
  quote: '<path d="M8 4c-2 0-3 1.2-3 3v3c0 1.5-.8 2-2 2 1.2 0 2 .5 2 2v3c0 1.8 1 3 3 3M16 4c2 0 3 1.2 3 3v3c0 1.5.8 2 2 2-1.2 0-2 .5-2 2v3c0 1.8-1 3-3 3"/>',
  chevron: '<path d="m6 9 6 6 6-6"/>',
  sun: '<circle cx="12" cy="12" r="4"/><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"/>',
  moon: '<path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/>',
  system: '<circle cx="12" cy="12" r="8.5"/><path d="M12 3.5v17" /><path d="M12 3.5a8.5 8.5 0 0 1 0 17z" fill="currentColor" stroke="none"/>',
  search: '<circle cx="11" cy="11" r="6.5"/><path d="m20 20-4.4-4.4"/>',
  link: '<path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1"/>',
  check: '<path d="m4.5 12.5 5 5 10-11"/>',
  pin: '<path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11z"/><circle cx="12" cy="10" r="2.3"/>',
};

const a11y = label ? { role: 'img' as const, 'aria-label': label } : { 'aria-hidden': 'true' as const };
---

{
  filled[name] ? (
    <svg class={cls} width={size} height={size} viewBox="0 0 24 24" fill="currentColor" focusable="false" {...a11y}>
      <path d={filled[name]} />
    </svg>
  ) : (
    <svg
      class={cls}
      width={size}
      height={size}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      focusable="false"
      {...a11y}
      set:html={stroked[name]}
    />
  )
}
