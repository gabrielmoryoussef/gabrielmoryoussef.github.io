---
import { render } from 'astro:content';
import Icon from './Icon.astro';
import { type Pub, STATUS_LABEL, statusGroup, isOwner, themeLabel } from '@/lib/content';

interface Props {
  pub: Pub;
  /** Heading level for the title. */
  level?: 'h3' | 'h4';
  /** Show theme tags (on the publications page). */
  showThemes?: boolean;
  index?: number;
}

const { pub, level = 'h3', showThemes = false, index = 0 } = Astro.props;
const { data, id } = pub;
const { Content } = await render(pub);
const hasAbstract = (pub.body ?? '').replace(/<!--[\s\S]*?-->/g, '').trim().length > 0;
const primary = data.links.pdf ?? data.links.arxiv ?? data.links.doi ?? data.links.journal;
const Heading = level;
const bibId = `bib-${id}`;
const absId = `abs-${id}`;
const review = statusGroup(data.status) === 'review';
const pending = data.status !== 'published';
---

<article
  class="pub"
  id={id}
  tabindex="-1"
  data-spotlight
  data-reveal
  style={`--i:${index % 6}`}
  data-themes={data.themes.join(' ')}
  data-status={statusGroup(data.status)}
>
  <div class="pub__badges">
    <span class="badge pub__venue">{data.venue}</span>
    {pending && <span class:list={['badge', 'badge--dot', review ? '' : 'badge--accent']}>{STATUS_LABEL[data.status]}</span>}
  </div>

  <div class="pub__main">
    <Heading class="pub__title">
      {primary ? <a href={primary} rel="noopener">{data.title}</a> : data.title}
    </Heading>
    <p class="pub__authors">
      {
        data.authors.map((a, i) => (
          <>
            {isOwner(a) ? <strong class="pub__me">{a}</strong> : <span>{a}</span>}
            {i < data.authors.length - 1 ? ', ' : ''}
          </>
        ))
      }
    </p>
    <p class="pub__where">
      {review ? `Under review at ${/^(Journal|Annals)\b/.test(data.venueFull ?? data.venue) ? 'the ' : ''}` : ''}{data.venueFull ?? data.venue}, {data.year}
      {
        showThemes && (
          <span class="pub__themes">
            {data.themes.map((t) => (
              <span class="pub__theme">#{themeLabel(t).toLowerCase().replace(/[^a-z0-9]+/g, '-')}</span>
            ))}
          </span>
        )
      }
    </p>

    <div class="pub__actions">
      {
        data.links.pdf && (
          <a class="btn" href={data.links.pdf} rel="noopener">
            <Icon name="pdf" /> PDF
          </a>
        )
      }
      {
        data.links.arxiv && (
          <a class="btn" href={data.links.arxiv} rel="noopener">
            <Icon name="arxiv" /> arXiv
          </a>
        )
      }
      {
        data.links.openreview && (
          <a class="btn" href={data.links.openreview} rel="noopener">
            <Icon name="link" /> OpenReview
          </a>
        )
      }
      {
        data.links.doi && (
          <a class="btn" href={data.links.doi} rel="noopener">
            <Icon name="link" /> DOI
          </a>
        )
      }
      {
        data.links.journal && (
          <a class="btn" href={data.links.journal} rel="noopener">
            <Icon name="link" /> Journal
          </a>
        )
      }
      {
        data.links.code && (
          <a class="btn" href={data.links.code} rel="noopener">
            <Icon name="code" /> Code
          </a>
        )
      }
      {
        data.bibtex && (
          <button class="btn" type="button" data-copy-bibtex={bibId} aria-label={`Copy BibTeX for “${data.title}”`}>
            <Icon name="quote" /> BibTeX
          </button>
        )
      }
      {
        hasAbstract && (
          <button class="btn pub__abs-btn" type="button" data-abstract-toggle aria-expanded="false" aria-controls={absId}>
            Abstract <Icon name="chevron" class="pub__chev" />
          </button>
        )
      }
    </div>

    {
      hasAbstract && (
        <div class="pub__abstract" id={absId} inert>
          <div class="pub__abstract-inner">
            <div class="pub__abstract-text">
              <Content />
            </div>
          </div>
        </div>
      )
    }
    {data.bibtex && <pre class="pub__bib" id={bibId} hidden>{data.bibtex.trim()}</pre>}
  </div>
</article>

<style>
  .pub {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-xs) var(--col-gap);
    padding-block: var(--space-m);
    scroll-margin-top: calc(var(--nav-h) + var(--space-l));
  }

  .pub + :global(.pub) {
    border-top: 1px solid var(--rule);
  }

  /* Cursor spotlight */
  .pub::after {
    content: '';
    position: absolute;
    inset: 0 calc(-1 * var(--space-s)) 0 calc(-1 * var(--space-m));
    z-index: -1;
    border-radius: var(--radius-m);
    background: radial-gradient(
      420px circle at var(--mx, 50%) var(--my, 50%),
      color-mix(in srgb, var(--accent) 7%, transparent),
      transparent 70%
    );
    opacity: 0;
    transition: opacity var(--dur-base) var(--ease-out);
    pointer-events: none;
  }

  /* Accent bar */
  .pub::before {
    content: '';
    position: absolute;
    left: calc(-1 * var(--space-s));
    top: var(--space-m);
    bottom: var(--space-m);
    width: 2px;
    background: var(--accent);
    border-radius: 2px;
    transform: scaleY(0);
    transform-origin: 50% 0;
    transition: transform var(--dur-base) var(--ease-out);
  }

  .pub__main,
  .pub__badges {
    transition: transform var(--dur-base) var(--ease-out);
  }

  @media (hover: hover) {
    .pub:hover::after {
      opacity: 1;
    }

    .pub:hover::before {
      transform: scaleY(1);
    }

    .pub:hover .pub__main,
    .pub:hover .pub__badges {
      transform: translateX(4px);
    }
  }

  .pub:target::before,
  .pub:focus-visible::before,
  .pub:global(.is-flash)::before {
    transform: scaleY(1);
  }

  .pub:global(.is-flash)::after,
  .pub:target::after {
    opacity: 1;
  }

  .pub:focus-visible {
    outline-offset: 0;
  }

  .pub__venue {
    white-space: normal;
    line-height: 1.3;
    max-width: 100%;
  }

  .pub__badges {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 0.4rem;
  }

  .pub__title {
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1.15;
    letter-spacing: -0.005em;
    max-width: 36ch;
  }

  .pub__title a {
    background-image: linear-gradient(var(--accent), var(--accent));
    background-size: 0% 1px;
    background-position: 0 92%;
    background-repeat: no-repeat;
    transition:
      background-size var(--dur-slow) var(--ease-out),
      color var(--dur-fast);
  }

  .pub__title a:hover {
    background-size: 100% 1px;
  }

  .pub__authors {
    margin-top: var(--space-2xs);
    font-size: var(--step--1);
    color: var(--ink-2);
  }

  .pub__me {
    color: var(--ink);
    font-weight: 600;
  }

  .pub__where {
    margin-top: 0.15rem;
    font-size: var(--step--1);
    font-style: italic;
    color: var(--ink-3);
  }

  .pub__themes {
    font-style: normal;
    margin-left: 0.5rem;
  }

  .pub__theme {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--ink-3);
    margin-right: 0.5rem;
  }

  .pub__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: var(--space-s);
  }

  .pub__abs-btn :global(.pub__chev) {
    transition: transform var(--dur-base) var(--ease-out);
  }

  .pub__abs-btn[aria-expanded='true'] {
    color: var(--ink);
    border-color: var(--rule-strong);
  }

  .pub__abs-btn[aria-expanded='true'] :global(.pub__chev) {
    transform: rotate(180deg);
  }

  .pub__abstract {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows var(--dur-slow) var(--ease-out);
  }

  .pub__abstract:global(.is-open) {
    grid-template-rows: 1fr;
  }

  .pub__abstract-inner {
    overflow: hidden;
  }

  .pub__abstract-text {
    margin-top: var(--space-s);
    padding-left: var(--space-s);
    border-left: 1px solid var(--rule-strong);
    max-width: 68ch;
    font-size: var(--step--1);
    line-height: 1.7;
    color: var(--ink-2);
    opacity: 0;
    transform: translateY(-4px);
    transition:
      opacity var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-out);
  }

  .pub__abstract:global(.is-open) .pub__abstract-text {
    opacity: 1;
    transform: none;
    transition-delay: 80ms;
  }

  .pub__bib {
    white-space: pre-wrap;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    background: var(--paper-raised);
    padding: var(--space-s);
    border-radius: var(--radius-s);
    margin: var(--space-s) 0 0;
    overflow-x: auto;
  }

  @media (min-width: 760px) {
    .pub {
      grid-template-columns: 11rem minmax(0, 1fr);
    }

    .pub__badges {
      flex-direction: column;
      align-items: flex-start;
      padding-top: 0.45rem;
    }
  }

  @media print {
    .pub {
      break-inside: avoid;
      padding: 0.6rem 0;
      margin: 0;
      grid-template-columns: 8rem 1fr;
    }

    .pub::before,
    .pub::after,
    .pub__actions,
    .pub__abstract {
      display: none;
    }

    .pub__title a::after {
      content: ' — ' attr(href);
      font-family: var(--font-mono);
      font-size: 8pt;
      color: #555;
      word-break: break-all;
    }
  }
</style>
